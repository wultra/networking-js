<?xml version="1.0" encoding="UTF-8"?>
<plugin xmlns="http://apache.org/cordova/ns/plugins/1.0" id="cordova-powerauth-networking" version="1.0.0">
    <name>PowerAuth Networking Cordova Plugin</name>
    <description>"A high-level networking SDK for PowerAuth-based endpoints.</description>
    <license>Apache 2.0</license>
    <keywords>cordova,powerauth,networking</keywords>
    <js-module name="WultraPowerAuthNetworking" src="lib/index.js">
        <!-- We want to expose all public APIs globally (on the window object) -->
        <merges target="window" />
    </js-module>
    <engines>
        <engine name="cordova" version=">=12.0.0"/>
        <engine name="cordova-android" version=">=12.0.0" />
        <engine name="cordova-ios" version=">=7.0.0" />
    </engines>
    <platform name="android" kotlin="1.9.22">
    </platform>
    <platform name="ios">
    </platform>
</plugin>